<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.stevenleadbeater.LoyaltyCardApp</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Loyalty Cards</name>
  <summary>Manage your loyalty and membership cards</summary>

  <developer id="io.github.stevenleadbeater">
    <name>Steven Leadbeater</name>
  </developer>
  <description>
    <p>
      A mobile-friendly application for managing loyalty cards, membership cards,
      and store reward programs. Keep all your cards in one place on your phone.
    </p>
    <p>Features:</p>
    <ul>
      <li>Store loyalty card barcodes and QR codes</li>
      <li>Adaptive layout for mobile and desktop</li>
      <li>Native GNOME/Phosh experience</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.stevenleadbeater.LoyaltyCardApp.desktop</launchable>

  <url type="homepage">https://github.com/stevenleadbeater/LoyaltyCardApp</url>
  <url type="bugtracker">https://github.com/stevenleadbeater/LoyaltyCardApp/issues</url>
  <url type="vcs-browser">https://github.com/stevenleadbeater/LoyaltyCardApp</url>

  <screenshots>
    <screenshot type="default">
      <video>https://github.com/stevenleadbeater/LoyaltyCardApp/releases/download/v0.1.3/demo.webm</video>
      <caption>Managing loyalty cards</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.5" date="2026-04-05">
      <description>
        <p>Added demo video.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-04-05">
      <description>
        <p>Fixes for Flathub submission.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-02-07">
      <description>
        <p>Initial release with basic project scaffold.</p>
      </description>
    </release>
  </releases>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
