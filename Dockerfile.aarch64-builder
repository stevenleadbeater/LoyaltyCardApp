# Dockerfile for building aarch64 flatpak bundles via QEMU emulation
#
# The flatpak-builder step runs at `docker run --privileged` time
# (not during `docker build`) because bwrap needs user namespaces.
#
# Usage (from Makefile):
#   docker build --platform linux/arm64 -f Dockerfile.aarch64-builder -t builder --target builder .
#   docker run --rm --privileged --platform linux/arm64 -v ./dist:/out builder

FROM arm64v8/fedora:41 AS builder

RUN dnf install -y \
    flatpak \
    flatpak-builder \
    bubblewrap \
    git \
    autoconf \
    automake \
    libtool \
    gettext-devel \
    && dnf clean all

# Native C build deps — used as fallback when unshare -m fails under QEMU
# (the SDK provides these inside its sandbox, but if mount namespaces don't
# work the shim runs builds directly on the host filesystem)
RUN dnf install -y \
    gcc \
    gcc-c++ \
    glibc-devel \
    make \
    meson \
    ninja-build \
    pkgconf-pkg-config \
    gstreamer1-devel \
    gstreamer1-plugins-base-devel \
    gtk4-devel \
    gobject-introspection-devel \
    glib2-devel \
    json-glib-devel \
    && dnf clean all

# Replace bwrap with a smart shim — user namespaces don't work under QEMU
# emulation. The shim processes --bind/--ro-bind/--symlink/--setenv/etc. args
# and applies them via unshare -m (mount namespace only, no user ns needed).
COPY bwrap-shim.sh /usr/bin/bwrap-shim.sh
RUN mv /usr/bin/bwrap /usr/bin/bwrap.real && \
    mv /usr/bin/bwrap-shim.sh /usr/bin/bwrap && \
    chmod +x /usr/bin/bwrap

RUN flatpak remote-add --if-not-exists flathub \
    https://flathub.org/repo/flathub.flatpakrepo

RUN flatpak install -y flathub \
    org.gnome.Sdk//48 \
    org.gnome.Platform//48

WORKDIR /build

# Copy the full app source tree
COPY . /build/

# Pre-download sources during docker build (QEMU-emulated curl is too slow)
# flatpak-builder cache format: downloads/{sha256}/{filename}
RUN mkdir -p /build/.flatpak-builder/downloads/212dfab527894b8bcbcc7cd1d43d63f5604a07473d31a5f02889e372614ebe28 && \
    curl -L -o /build/.flatpak-builder/downloads/212dfab527894b8bcbcc7cd1d43d63f5604a07473d31a5f02889e372614ebe28/0.23.93.tar.gz \
      https://github.com/mchehab/zbar/archive/refs/tags/0.23.93.tar.gz && \
    mkdir -p /build/.flatpak-builder/downloads/3d386af3d1dbd1a06c74a6251250c269b481e703f0e3255ba89ef6c1e063afea && \
    curl -L -o /build/.flatpak-builder/downloads/3d386af3d1dbd1a06c74a6251250c269b481e703f0e3255ba89ef6c1e063afea/gst-plugins-bad-1.24.12.tar.xz \
      https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-1.24.12.tar.xz && \
    mkdir -p /build/.flatpak-builder/downloads/de801ee349ed3c255a9af3c01b1a401fab5b3fc1c35eb2fd7dfb35d4b8194d7f && \
    curl -L -o /build/.flatpak-builder/downloads/de801ee349ed3c255a9af3c01b1a401fab5b3fc1c35eb2fd7dfb35d4b8194d7f/libportal-0.9.1.tar.xz \
      https://github.com/flatpak/libportal/releases/download/0.9.1/libportal-0.9.1.tar.xz

# The build + bundle steps run at container start (needs --privileged for bwrap)
CMD flatpak-builder --repo=/build/repo --force-clean --disable-rofiles-fuse \
    /build/build-dir \
    com.github.loyaltycardapp.LoyaltyCardApp.json && \
    mkdir -p /build/dist && \
    flatpak build-bundle /build/repo \
    /build/dist/com.github.loyaltycardapp.LoyaltyCardApp-aarch64.flatpak \
    com.github.loyaltycardapp.LoyaltyCardApp && \
    cp /build/dist/*.flatpak /out/
