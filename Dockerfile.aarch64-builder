# Dockerfile for building aarch64 flatpak bundles via QEMU emulation
#
# The flatpak-builder step runs at `docker run --privileged` time
# (not during `docker build`) because bwrap needs user namespaces.
#
# Usage (from Makefile):
#   docker build --platform linux/arm64 -f Dockerfile.aarch64-builder -t builder --target builder .
#   docker run --rm --privileged --platform linux/arm64 -v ./dist:/out builder

FROM arm64v8/fedora:41 AS builder

RUN dnf install -y \
    flatpak \
    flatpak-builder \
    bubblewrap \
    git \
    && dnf clean all

# Replace bwrap with a no-op passthrough — user namespaces don't work
# under QEMU emulation. bwrap is called as: bwrap [opts...] -- cmd [args...]
RUN mv /usr/bin/bwrap /usr/bin/bwrap.real && \
    printf '#!/bin/sh\nwhile [ "$1" != "--" ] && [ $# -gt 0 ]; do shift; done\nshift\nexec "$@"\n' > /usr/bin/bwrap && \
    chmod +x /usr/bin/bwrap

RUN flatpak remote-add --if-not-exists flathub \
    https://flathub.org/repo/flathub.flatpakrepo

RUN flatpak install -y flathub \
    org.gnome.Sdk//48 \
    org.gnome.Platform//48

WORKDIR /build

# Copy the full app source tree
COPY . /build/

# The build + bundle steps run at container start (needs --privileged for bwrap)
CMD flatpak-builder --repo=/build/repo --force-clean --disable-rofiles-fuse \
    /build/build-dir \
    com.github.loyaltycardapp.LoyaltyCardApp.json && \
    mkdir -p /build/dist && \
    flatpak build-bundle /build/repo \
    /build/dist/com.github.loyaltycardapp.LoyaltyCardApp-aarch64.flatpak \
    com.github.loyaltycardapp.LoyaltyCardApp && \
    cp /build/dist/*.flatpak /out/
